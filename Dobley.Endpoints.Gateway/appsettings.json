{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catch-all}"
          }
        ]
      },
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catch-all}"
          }
        ]
      },
      "ui-root-route": {
        "ClusterId": "ui-cluster",
        "Match": {
          "Path": "/ui"
        },
        "Transforms": [
          {
            "PathSet": "/"
          }
        ]
      },
      "ui-route": {
        "ClusterId": "ui-cluster",
        "Match": {
          "Path": "/ui/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://dobley.auth:5002/"
          }
        }
      },
      "api-cluster": {
        "Destinations": {
          "api": {
            "Address": "http://dobley.api:5001/"
          }
        }
      },
      "ui-cluster": {
        "Destinations": {
          "ui": {
            "Address": "http://dobley.ui:5003/"
          }
        }
      }
    }
  }
}
