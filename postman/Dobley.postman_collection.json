    {
      "name": "Notifications",
      "item": [
        {
          "name": "Create Invite",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('notificationInviteId', json.id);",
                  "  pm.collectionVariables.set('notificationInviteCode', json.code);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Connection",
                "value": "close"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expiresAt\": \"{{notificationExpiresAt}}\"\n}"
            },
            "url": "{{baseUrl}}/api/notifications/invites/create"
          }
        },
        {
          "name": "Get Recipients",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (Array.isArray(json) && json.length > 0) {",
                  "    pm.collectionVariables.set('notificationRecipientId', json[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Connection",
                "value": "close"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/notifications/recipients"
          }
        },
        {
          "name": "Subscribe Recipient To Storage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Connection",
                "value": "close"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storageIds\": [\n    {{storageId}}\n  ],\n  \"notifyBeforeDays\": {{notifyBeforeDays}}\n}"
            },
            "url": "{{baseUrl}}/api/notifications/recipients/{{notificationRecipientId}}/subscriptions"
          }
        },
        {
          "name": "Disable Recipient Mailing",
          "request": {
            "method": "DELETE",
            "header": [
