# Ignore .DS_Store files on macOS
.DS_Store

# Ignore Visual Studio and Rider temporary files
*.suo
*.user
*.userosscache
*.sln.docstates

# Ignore build output folders
bin/
obj/

# Ignore NuGet packages folder
packages/

# Ignore .vs folder (Visual Studio)
.vs/

# Ignore .idea folder (Rider/IntelliJ)
.idea/

# Ignore local environment files
.env
.env.local
.env.*.local

# Ignore logs and local databases
*.log
*.sqlite
*.db

# Ignore dotnet tools manifest (если локальные инструменты не нужны)
.dotnet/
.tools/

# Ignore Docker-related files (если они генерируются автоматически)
docker-compose.override.yml
.dockerignore

# Ignore publish output
publish/

# Ignore temporary files
*~
*.tmp

# Ignore JetBrains Rider files
*.DotSettings.user
*.DotSettings

# Ignore Node.js dependencies if applicable
node_modules/

# Ignore Python virtual environments if applicable
venv/
ENV/
env/
